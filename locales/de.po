msgstr "nicht erreicht"

msgid "not set up"
msgstr "nicht angelegt"

msgid "optional, not running"
msgstr "optional, läuft nicht"

msgid "unchecked"
msgstr "ungeprüft"

msgid "update"
msgstr "Update"

msgid "{image} available"
msgstr "{image} verfügbar"

