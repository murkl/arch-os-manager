msgstr "Theme übersprungen: {error}"

msgid ""
"This is no configuration update\n"
"Only .pacnew and .pacsave files are taken over, removed or merged.\n"
msgstr ""
"Das ist kein Konfigurationsupdate\n"
"Übernommen, gelöscht oder zusammengeführt werden nur .pacnew- und .pacsave-Dateien.\n"

